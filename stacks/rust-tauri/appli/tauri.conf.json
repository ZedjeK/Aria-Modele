{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aria {{NOM}}",
  "identifier": "io.github.zedjek.aria-{{NOM_MIN}}",
  "build": {
    "frontendDist": "../interface/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self'; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "publisher": "ZedjeK",
    "copyright": "© {{ANNEE}} ZedjeK",
    "shortDescription": "{{PROMESSE}}",
    "icon": ["icons/icon.ico"]
  }
}
