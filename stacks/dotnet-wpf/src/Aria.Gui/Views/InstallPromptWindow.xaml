<Window
  x:Class="Aria.Gui.Views.InstallPromptWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Installer Aria {{NOM}}"
  Width="560"
  SizeToContent="Height"
  ResizeMode="NoResize"
  WindowStartupLocation="CenterScreen"
  Icon="pack://application:,,,/Assets/Aria-Modele.ico"
  Background="{StaticResource Fond}"
  Foreground="{StaticResource Texte}"
  FontFamily="{StaticResource PoliceInterface}">
  <StackPanel Margin="24">
    <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" />
    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
               Text="L'appli peut se ranger dans ton dossier de données et se lancer de là. Rien n'est installé ailleurs, et rien ne change dans Windows." />

    <Border Margin="0,16,0,0" Style="{StaticResource StylePanneau}">
      <StackPanel>
        <TextBlock Text="Dossier d'installation" Foreground="{StaticResource TexteSecondaire}" />
        <TextBlock x:Name="DestinationText" Margin="0,4,0,0" FontFamily="{StaticResource PoliceCode}" TextWrapping="Wrap" />
        <TextBlock x:Name="InstalledText" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
      </StackPanel>
    </Border>

    <CheckBox x:Name="ShortcutBox" Margin="0,16,0,0" Content="Créer un raccourci sur le Bureau" />
    <TextBlock x:Name="ShortcutHelp" Margin="28,2,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TexteSecondaire}" />

    <CheckBox x:Name="DontAskBox" Margin="0,12,0,0" Content="Ne plus me proposer l'installation" />
    <TextBlock Margin="28,2,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TexteSecondaire}"
               Text="Pris en compte avec « Lancer sans installer ». La proposition se réactive dans la fenêtre de l'appli." />

    <TextBlock x:Name="StatusText" Margin="0,16,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

    <StackPanel Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="RunButton" Margin="0,0,12,0" Padding="16,8" Content="Lancer sans installer"
              Background="Transparent" BorderBrush="{StaticResource Cyan}" Foreground="{StaticResource Cyan}" Click="OnRunHere" />
      <Button x:Name="InstallButton" Padding="16,8" Content="Installer"
              Background="{StaticResource Orange}" Foreground="{StaticResource Fond}" FontWeight="SemiBold" Click="OnInstall" />
    </StackPanel>
  </StackPanel>
</Window>
