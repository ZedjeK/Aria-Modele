<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms ne sert qu'à l'icône de la zone de notification (Services\TrayIcon.cs) -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Le DPI reste réglé par app.manifest : Windows Forms n'a pas de fenêtre ici -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <RootNamespace>Aria.Gui</RootNamespace>
    <AssemblyName>Aria-{{NOM}}</AssemblyName>
    <!-- « Description du fichier » dans Windows -->
    <AssemblyTitle>Aria {{NOM}}</AssemblyTitle>
    <!-- Droits de l'utilisateur seulement (asInvoker) et DPI par écran : voir app.manifest -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Point d'entrée : Program.Main vérifie les fichiers livrés avant de démarrer WPF -->
    <StartupObject>Aria.Gui.Program</StartupObject>
    <!-- Icône de l'exe (Explorateur, barre des tâches) : à remplacer par celle de l'appli -->
    <ApplicationIcon>Assets\Aria-Modele.ico</ApplicationIcon>

    <!-- Publication : un exe autonome, rien à installer -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Les bibliothèques natives de WPF restent à côté de l'exe : embarquées, elles seraient extraites dans
         %TEMP%\.net\ à chaque lancement, et le contrat interdit d'écrire dans %TEMP%. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- Pas de compression : un exe qui se décompresse lui-même alerte souvent les antivirus (fichier plus gros, en contrepartie) -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Contrôles au style Windows 11 (fenêtre, barre de titre, thème sombre) -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Aria-Modele.ico" />
    <!-- Polices embarquées : Space Grotesk (interface), IBM Plex Mono (code) -->
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aria.Core\Aria.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- App.xaml ne génère pas de Main : c'est Program.Main qui démarre l'appli -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Noms de Windows Forms (Application, MessageBox, Color…) : jamais importés d'office, ils se confondraient avec ceux de WPF -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
