<Application
  x:Class="Aria.Gui.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="Theme/Aria.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Couleurs de WPF-UI remplacées par la palette Aria. Définies ici, et non dans un dictionnaire fusionné,
           elles restent prioritaires même si le thème est rechargé. -->
      <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FF030812" />
      <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFDDEBFF" />
      <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF93A8C8" />
      <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
      <CornerRadius x:Key="PopupCornerRadius">2</CornerRadius>
    </ResourceDictionary>
  </Application.Resources>
</Application>
